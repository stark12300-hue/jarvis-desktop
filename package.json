{
  "name": "jarvis-desktop",
  "version": "0.1.0",
  "description": "Cross-platform JARVIS-style desktop assistant starter",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.jarvis.assistant",
    "productName": "JARVIS",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity" },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}