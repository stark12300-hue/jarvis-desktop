{
  "name": "jarvis-desktop",
  "version": "0.3.1",
  "description": "Cross-platform JARVIS voice assistant and Android companion",
  "main": "src/main.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node --check server.js",
    "check": "node --check server.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.jarvis.assistant",
    "productName": "JARVIS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "JARVIS uses the microphone for voice commands when you tap Speak a command."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
